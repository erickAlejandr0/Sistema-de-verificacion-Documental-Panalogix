# SVD Panalogix — variables de entorno de ejemplo
# Copiar a .env y completar. Nunca commitear secretos reales.
# Todas las variables son obligatorias; Settings falla al arranque si falta alguna.

# Ambiente: dev | staging | prod
ENVIRONMENT=dev

# AWS
AWS_REGION=us-east-1
AWS_S3_RAW_BUCKET=
AWS_S3_VERIFIED_BUCKET=
AWS_SQS_QUEUE_URL=
AWS_SNS_TOPIC_ARN=

# RDS PostgreSQL (schema verificaciones)
DATABASE_URL=

# KMS — cifrado PII (Ley 81 de 2019)
KMS_KEY_ID=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Estrategia híbrida: modelo primario (Haiku) y fallback (Sonnet)
MODELO_PRIMARIO=
MODELO_FALLBACK=

# Umbrales (0.0–1.0): confianza para escalar a Sonnet; autenticidad para revisión manual
UMBRAL_CONFIANZA=0.92
UMBRAL_AUTENTICIDAD=0.70

# Penalizaciones de autenticidad (MVP calibrables; defaults si se omiten)
AUTH_PENALTY_ANOMALIA=0.100
AUTH_PENALTY_TEMPORAL=0.200
AUTH_PENALTY_EXIF=0.150

# PDF → imágenes (pdf2image + poppler Layer); exceso → DocumentTooManyPagesError
MAX_PAGINAS_PDF=5

# Versión del pipeline de extracción (idempotencia + trazabilidad RF-24)
VERSION_EXTRACCION=1.0.0

# API REST (Lambda api_handler) — keys servicio-a-servicio (SSM SecureString en deploy)
# Header: X-SVD-Api-Key
PANALOGIX_API_KEY=
RETOOL_API_KEY=

# Webhook emisor (Lambda webhook_handler) — destino genérico HTTPS + HMAC
# Sin default de dominio; SSM SecureString en deploy:
#   /svd/{env}/WEBHOOK_URL , /svd/{env}/WEBHOOK_HMAC_SECRET
WEBHOOK_URL=
WEBHOOK_HMAC_SECRET=
# Opcionales (defaults en WebhookSettings):
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_ATTEMPTS=3
